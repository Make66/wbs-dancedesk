model Module {
  name     String @default("Module 1")
  seq Int    @default(0)
  color    String @default("#B5252B")
  active    Boolean    @default(true)

  // Common fields
  id        String   @id @default(cuid())
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

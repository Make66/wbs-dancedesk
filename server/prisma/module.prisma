model Module {
  name   String  @default("Standard Modul")
  seq    Int     @default(0)
  color  String  @default("#B5252B")
  active Boolean @default(true)

  // relations
  users User[] @relation("UserModules") // Many-to-many relation with User

  // Common fields
  id        String   @id @default(cuid())
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

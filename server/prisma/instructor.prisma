model Instructor {
  name     String? @default("John Doe Instructor")
  imageUrl String  @default("./assets/images/no-profile-picture")
  active    Boolean    @default(true)
  courses  Course[]

  // Common fields
  id        String   @id @default(cuid())
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

model Instructor {
  name         String?  @default("John Doe Instructor")
  description  String?  @default("")
  email        String   @unique
  password     String   @default("Test123!")
  refreshToken String? // bcrypt hash of current refresh token; null = logged out
  imageUrl     String   @default("/assets/images/no-profile-picture.svg")
  skills       String[] @default(["Salsa", "WTP", "HipHop"])

  // relations
  courses    Course[]
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String   @db.Uuid

  // Common fields
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
}

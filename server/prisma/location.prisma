model Location {
  name        String? @default("John Doe Instructor")
  description String? @default("")
  imageUrl    String  @default("./assets/images/no-profile-picture")

  // Common address fields
  street    String @default("123 Main St")
  city      String @default("Anytown")
  zipCode   String @default("12345")
  state     String @default("State")
  longitude Float  @default(0.0)
  latitude  Float  @default(0.0)

  // relations
  setSeqTarget String[]  @db.Uuid
  courses      Course[]
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerId   String?   @db.Uuid
  events       Event[]
  targets      Target[]
  users        User[]    @relation("UserLocations") // Many-to-many relation with User
  rooms        Room[]

  // Common fields
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
}

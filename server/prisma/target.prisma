model Target {
  name   String?  @default("Erwachsene")
  icon   String   @default("")
  color  String[] @default(["#000000", "#FFFFFF"])
  active Boolean  @default(true)

  // relations
  setSeqCategory Json?      @default("{}") // { parent: UUID, categories: UUID[] }
  categories     Category[]
  location       Location?  @relation(fields: [locationId], references: [id])
  locationId     String?

  // Common fields
  id        String   @id @default(cuid())
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

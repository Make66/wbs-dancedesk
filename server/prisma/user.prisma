model User {
  firstName    String? @default("John Doe")
  lastName     String? @default("Doe")
  email        String  @unique @default("admin@test.de")
  password     String  @default("Test123!")
  imageUrl     String  @default("./assets/images/no-profile-picture")
  active       Boolean @default(true)
  refreshToken String? // bcrypt hash of current refresh token; null = logged out

  // relations from here
  locations Location[] @relation("UserLocations") // Many-to-many relation with Location
  modules   Module[]   @relation("UserModules") // Many-to-many relation with Module

  // Common fields
  id        String   @id @default(cuid())
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

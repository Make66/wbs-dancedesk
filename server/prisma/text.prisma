model Text {
  name        String? @default("")
  description String? @default("")
  type        Int     @default(0) // 0 = terms, 1 = info
  text        String  @default("")

  // relations 1:n — one Text record can serve as terms for many courses,
  // and separately as info for many courses (distinguished by Text.type)
  coursesAsTerms Course[] @relation("textTerms")
  coursesAsInfo  Course[] @relation("textInfo")

  // Common fields
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
}

model Text {
  name String? @default("Erwachsene")
  type Int     @default(0) // 0 = terms, 1 = info
  text String  @default("Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.")

  // relations
  courseTerms Course[] @relation("CourseTerms")
  courseInfo  Course[] @relation("CourseInfo")
  courses     Course[]

  // Common fields
  id        String   @id @default(cuid())
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

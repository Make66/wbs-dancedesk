model Settings {
  basic        Json?
  calendar     Json? @default("{\"startHour\":10,\"endHour\":20,\"slotHeight\":20,\"minutesPerSlot\":15}")
  formFields   Json?
  registration Json?
  contracts    Json?
  rebates      Json?
  voucher      Json?
  other        Json?

  // common
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

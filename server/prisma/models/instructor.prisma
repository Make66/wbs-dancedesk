model Instructor {
  name     String? @default("John Doe Instructor")
  imageUrl String  @default("./assets/images/no-profile-picture")

  // Common fields
  id        String   @id @default(cuid())
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

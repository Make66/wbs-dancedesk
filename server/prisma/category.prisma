model Category {
  name   String?  @default("Paare Grundkurs")
  color  String[] @default(["#000000", "#FFFFFF"])
  active Boolean  @default(true)

  // relations
  target       Target   @relation(fields: [targetId], references: [id])
  targetId     String
  setSeqCourse Json?    @default("{}") // { parent: UUID, course: UUID[] }
  courses      Course[]

  // Common fields
  id        String   @id @default(cuid())
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

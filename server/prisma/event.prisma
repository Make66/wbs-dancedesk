model Event {
  title       String?  @default("John Doe Instructor")
  description String?  @default("")
  imageUrl    String   @default("/assets/images/no-profile-picture.svg")
  startsAt    DateTime @default(now())
  endsAt      DateTime @default(now())
  color       Json?    @default("[]")
  icon        String   @default("event")
  type        String   @default("event")

  // Common address fields
  street    String @default("123 Main St")
  city      String @default("Anytown")
  zipCode   String @default("12345")
  longitude Float  @default(0.0)
  latitude  Float  @default(0.0)

  // relations
  location   Location? @relation(fields: [locationId], references: [id])
  locationId String?   @db.Uuid
  posts      Post[]
  room       Room?     @relation(fields: [roomId], references: [id])
  roomId     String?   @db.Uuid
  targets    Target[]  @relation("EventTargets")

  // Common fields
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
}

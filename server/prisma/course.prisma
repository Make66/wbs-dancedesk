model Course {
  name             String?  @default("Grundkurs 1")
  description      String?  @default("")
  startsAt         DateTime @default(now())
  endsAt           DateTime @default(now())
  frequency        String   @default("weekly")
  clubRepetition   Int      @default(50)
  courseRepetition Int      @default(8)
  dates            Json     @default("[]")
  contracts        Json[]   @default([])
  options          Int      @default(0)
  seatsCurrent     Int      @default(20)
  seatsMax         Int      @default(20)
  color            Json?    @default("[]")

  isBookedOut      Boolean @default(false)
  isClub           Boolean @default(false)
  isIgnoreCalendar Boolean @default(false)
  isTaxFree        Boolean @default(false)

  // relations from other models
  attendances  Attendance[]
  category     Category    @relation(fields: [categoryId], references: [id])
  categoryId   String      @db.Uuid
  instructor   Instructor? @relation(fields: [instructorId], references: [id])
  instructorId String?     @db.Uuid
  location     Location?   @relation(fields: [locationId], references: [id])
  locationId   String?     @db.Uuid
  registrations Registration[]
  room         Room?       @relation(fields: [roomId], references: [id])
  roomId       String?     @db.Uuid
  textTerms    Text?       @relation("textTerms", fields: [textTermsId], references: [id])
  textTermsId  String?     @db.Uuid
  textInfo     Text?       @relation("textInfo", fields: [textInfoId], references: [id])
  textInfoId   String?     @db.Uuid

  // n:m relations
  participants       Participant[]       @relation("ParticipantCourse")
  participantCourses ParticipantCourse[]

  // Common fields
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)

  // remark on dates: On the application side, when reading dates from Prisma 
  // it will come back as unknown / JsonValue — you may need to cast it to any[] 
  // or your specific date type where you use it.
  // for postgres use dates Json[] @default("[]")
}

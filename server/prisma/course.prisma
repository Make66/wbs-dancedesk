model Course {
  name             String?  @default("Grundkurs 1")
  seq              Int      @default(0)
  active           Boolean  @default(true)
  startsAt         DateTime @default(now())
  endsAt           DateTime @default(now())
  repeat           Int      @default(0)
  frequency        String   @default("weekly")
  isIgnoreCalendar Boolean  @default(false)
  dates            Json     @default("[]")
  seatsCurrent     Int      @default(20)
  seatsMax         Int      @default(20)
  paymentTypes     String[] @default(["bar", "paypal", "bank"])
  contractTypes    String[] @default(["standard", "trial"])

  // relations from other models
  category     Category    @relation(fields: [categoryId], references: [id])
  categoryId   String
  room         Room?       @relation(fields: [roomId], references: [id])
  roomId       String?
  text         Text?       @relation(fields: [textId], references: [id])
  textId       String?
  textTerms    Text?       @relation("CourseTerms", fields: [textTermsId], references: [id])
  textTermsId  String?
  textInfo     Text?       @relation("CourseInfo", fields: [textInfoId], references: [id])
  textInfoId   String?
  instructor   Instructor? @relation(fields: [instructorId], references: [id])
  instructorId String?

  // Common fields
  id        String   @id @default(cuid())
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  // remark on dates: On the application side, when reading dates from Prisma 
  // it will come back as unknown / JsonValue — you may need to cast it to any[] 
  // or your specific date type where you use it.
  // for postgres use dates Json[] @default("[]")
}

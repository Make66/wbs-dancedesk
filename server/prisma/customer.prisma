model Customer {
  name       String  @default("DanceSchool Flip'n Bit")
  email      String  @unique @default("noreply@email.de")
  website    String  @default("https://www.wbscodingschool.com")
  logoUrl    String  @default("https://gui4.kurstool.de/assets/images/logo.webp")
  primary    String  @default("#B80000")
  secondary  String  @default("#5F0000")
  tertiary   String  @default("#565656")
  quaternary String  @default("#BABABA")
  signInKey String  @default("") @unique
  code      String  @unique @default("")
  active     Boolean @default(true)

  // relations
  setSeqInstructor String[]     @db.Uuid
  setSeqTarget     String[]     @db.Uuid
  instructors      Instructor[]
  locations        Location[]

  // Common address fields
  street    String @default("123 Main St")
  city      String @default("Any town")
  zipCode   String @default("12345")
  longitude Float  @default(0.0)
  latitude  Float  @default(0.0)

  // Common fields
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}
